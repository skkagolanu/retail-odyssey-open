{
  "uid": "retail-open",
  "title": "Retail Odyssey Open - Agent pipeline",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Agent invocations / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent, mode, status) (rate(retail_agent_runs_total[5m]))",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Mean agent latency (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(retail_stage_duration_seconds_sum[5m])) / sum by (stage) (rate(retail_stage_duration_seconds_count[5m]))",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(retail_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Actual / reserved model tokens per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent, kind) (rate(retail_model_tokens_total[5m]))",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Provider failures per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(retail_provider_failures_total[5m]))",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Active stored sessions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "retail_active_sessions",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Created sessions / clears",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"retail_sessions_created_total|retail_conversations_cleared_total\"}",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Returned product cards",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retail-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "retail_products_returned_total",
          "legendFormat": "{{agent}} {{stage}} {{kind}} {{route}} {{mode}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
