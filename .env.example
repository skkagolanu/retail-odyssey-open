# The complete catalogue demo needs no key and makes no model requests.
RO_ENGINE=catalogue
RO_DATABASE_PATH=var/sessions.sqlite3
RO_CATALOGUE_PATH=data/catalogue.json
RO_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
RO_TRUSTED_HOSTS=["localhost","127.0.0.1"]
# Set true behind HTTPS; browsers will not send secure cookies over plain HTTP.
RO_SECURE_COOKIES=false
# Optional local inference. Pull this model explicitly before choosing ollama mode.
RO_OLLAMA_URL=http://127.0.0.1:11434
RO_OLLAMA_MODEL=qwen3-vl:4b-instruct
RO_OLLAMA_THREADS=2
# Optional self-hosted ComfyUI and an administrator-owned API-format workflow.
# RO_COMFYUI_URL=http://127.0.0.1:8188
# RO_COMFYUI_WORKFLOW=/absolute/path/to/workflow-api.json

# Cloud mode: Render Free + Cloudflare Workers Free. Set privately on the server.
# RO_ENGINE=cloudflare
# RO_CLOUDFLARE_ACCOUNT_ID=<your Cloudflare account ID>
# RO_CLOUDFLARE_API_TOKEN=<private account-scoped Workers AI token>
# Set true only after verifying Workers Free, without paid billing/AI Gateway credits.
# RO_CLOUDFLARE_FREE_PLAN_CONFIRMED=true
